<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>                  <string>Sermon Translation</string>
    <key>CFBundleDisplayName</key>           <string>Sermon Translation</string>
    <key>CFBundleIdentifier</key>            <string>app.slashai.sermon-translation</string>
    <key>CFBundleExecutable</key>            <string>launch</string>
    <key>CFBundleIconFile</key>              <string>appicon</string>
    <key>CFBundlePackageType</key>           <string>APPL</string>
    <key>CFBundleVersion</key>               <string>1</string>
    <key>CFBundleShortVersionString</key>    <string>1.0</string>
    <key>LSMinimumSystemVersion</key>        <string>13.0</string>

    <!-- Without these, macOS denies the folder silently instead of asking. The project
         usually sits in Documents or on the Desktop, both of which are protected. -->
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Sermon Translation needs to read its own project folder, which is in your Documents.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>Sermon Translation needs to read its own project folder, which is on your Desktop.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>Sermon Translation needs to read its own project folder, which is in your Downloads.</string>

    <!-- The mic prompt is attributed to this bundle, so this is the sentence the
         volunteer reads when macOS asks. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Sermon Translation listens to the preacher so it can translate the sermon for people on the church wifi. The audio never leaves this Mac.</string>
</dict>
</plist>
